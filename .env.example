# Google Drive (opcional) — OAuth 2.0 PKCE
# 1. Crie um projeto no Google Cloud Console
# 2. Ative a API Google Drive
# 3. Crie credencial OAuth "Aplicativo da Web"
# 4. Authorized redirect URIs:
#    - http://localhost:5173/oauth-callback.html  (dev)
#    - https://guilhermeroesler.github.io/Zue/oauth-callback.html  (web + bridge Android)
# 5. Cole o Client ID abaixo

VITE_GOOGLE_OAUTH_CLIENT_ID=

# Opcional — sobrescreve o redirect padrão
# VITE_GOOGLE_OAUTH_REDIRECT_URI=
# VITE_GOOGLE_OAUTH_NATIVE_REDIRECT_URI=https://guilhermeroesler.github.io/Zue/oauth-callback.html
