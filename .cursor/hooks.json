{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/session-start.mjs",
        "timeout": 30
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/after-file-edit.mjs",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/stop-sync-specs.mjs",
        "timeout": 45,
        "loop_limit": 2
      }
    ]
  }
}
